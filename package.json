{
  "name": "green-color-networks",
  "version": "1.0.0",
  "private": true,
  "description": "Green Color Networks — Safaricom products e-commerce platform (airtime, data bundles, minutes, phones) with M-Pesa Daraja payments and full admin back-office.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "node scripts/start.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:migrate": "wrangler d1 migrations apply greenclone-db --remote",
    "cf:migrate:local": "wrangler d1 migrations apply greenclone-db --local",
    "preview": "prisma generate && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "prisma generate && opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@prisma/adapter-d1": "^6.5.0",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "iron-session": "^8.0.3",
    "lucide-react": "^0.487.0",
    "nanoid": "^5.1.5",
    "next": "^15.3.0",
    "prisma": "^6.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@opennextjs/cloudflare": "^1.3.0",
    "@tailwindcss/postcss": "^4.1.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.8.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.20.0"
  }
}
